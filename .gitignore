# Python
__pycache__/
*.pyc
.venv/
venv/

# Recognition service local data (biometric embeddings, logs, models) - never commit
recognition/.env
recognition/data/embeddings/*
!recognition/data/embeddings/.gitkeep
recognition/data/logs/*
!recognition/data/logs/.gitkeep
recognition/data/test_set/known/*
!recognition/data/test_set/known/.gitkeep
recognition/data/test_set/unknown/*
!recognition/data/test_set/unknown/.gitkeep
recognition/data/snapshots/*
!recognition/data/snapshots/.gitkeep

# InsightFace downloaded model weights
.insightface/

# Node / NestJS / Next.js
node_modules/
backend/dist/
backend/.env
backend/uploads/
frontend/.next/
frontend/.env*.local
frontend/.env
npm-debug.log*

