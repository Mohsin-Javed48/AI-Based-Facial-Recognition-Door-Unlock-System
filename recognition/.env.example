# Camera source for cv2.VideoCapture(). 0 = default built-in webcam.
# In later phases this becomes a capture-card index or an RTSP URL - no other
# code changes required.
CAMERA_SOURCE=0

# InsightFace model pack + detector input size.
INSIGHTFACE_MODEL_PACK=buffalo_l
INSIGHTFACE_DET_SIZE=640

# Cosine-similarity threshold for accepting a match as "recognized".
# Starting value only - tune with scripts/evaluate_thresholds.py.
RECOGNITION_THRESHOLD=0.50

# Minimum seconds between two gate triggers for the same recognized member,
# so one visit doesn't fire the (stub) gate every frame.
GATE_COOLDOWN_SECONDS=12

# Where embeddings and local logs are stored.
DATA_DIR=./data

LOG_LEVEL=INFO
