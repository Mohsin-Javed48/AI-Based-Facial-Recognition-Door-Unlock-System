# Postgres (matches docker-compose.yml at the repo root)
DATABASE_URL="postgresql://gate_app:gate_app_dev_password@localhost:5433/gate_access?schema=public"

# Redis (matches docker-compose.yml - host port 6380, not the default 6379,
# to avoid colliding with any other Redis instance already running locally)
REDIS_URL="redis://localhost:6380"
REDIS_RECOGNITION_CHANNEL="gate:recognition-events"

# Auth - single-admin login (see README/docs Section 14). Generate your own
# hash: node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH="$2b$10$sXZ8KZNUBPiILIudbf7PIOud8HS/RNkLbYvuZO2k53yHvu2clBDia"
JWT_SECRET=replace-with-a-long-random-value
JWT_EXPIRES_IN=8h

# Recognition service (Python, Phase 0) - used only for a health-check hint;
# there is no HTTP server on that side, see docs/phase1.md Section on health.
PYTHON_SERVICE_STALE_AFTER_SECONDS=30

# Shared filesystem path to the recognition service's snapshot directory -
# this assumes backend and recognition run on the same machine (this
# project's whole design, see README Section 1). Defaults to the sibling
# recognition/ folder if unset.
RECOGNITION_SNAPSHOTS_DIR=../recognition/data/snapshots

PORT=3001
CORS_ORIGIN=http://localhost:3000
